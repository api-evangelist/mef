    "version": "1.0.1"
  },
  "items": [
    {
      "info": {
        "name": "Service Order",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List or find ServiceOrder objects",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/serviceOrder",
            "params": [
              {
                "name": "state",
                "value": "",
                "type": "query",
                "description": "State of the Service Order"
              },
              {
                "name": "orderDate.gt",
                "value": "",
                "type": "query",
                "description": "Date when the order was created greater than"
              },
              {
                "name": "orderDate.lt",
                "value": "",
                "type": "query",
                "description": "Date when the order was created lesser than"
              },
              {
                "name": "completionDate.gt",
                "value": "",
                "type": "query",
                "description": "Effective completion date greater than"
              },
              {
                "name": "completionDate.lt",
                "value": "",
                "type": "query",
                "description": "Effective completion date lesser than"
              },
              {
                "name": "expectedCompletionDate.gt",
                "value": "",
                "type": "query",
                "description": "Expected delivery date greater than"
              },
              {
                "name": "expectedCompletionDate.lt",
                "value": "",
                "type": "query",
                "description": "Expected delivery date lesser than"
              },
              {
                "name": "startDate.gt",
                "value": "",
                "type": "query",
                "description": "Date when the order was started for processing"
              },
              {
                "name": "startDate.lt",
                "value": "",
                "type": "query",
                "description": "Date when the order was started for processing"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Requested index for start of item to be provided in response requested by the client. Note that the index starts with \"0\"."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Requested number of items to be provided in response requested by client"
              }
            ]
          },
          "docs": "This operation retrieves list of ServiceOrder entities."
        },
        {
          "info": {
            "name": "Creates a ServiceOrder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/serviceOrder",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "This operation creates a ServiceOrder entity."
        },
        {
          "info": {
            "name": "Retrieves a ServiceOrder by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/serviceOrder/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the ServiceOrder"
              }
            ]
          },
          "docs": "This operation retrieves a ServiceOrder entity."
        }
      ]
    },
    {
      "info": {
        "name": "Events subscription",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register a listener",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/hub",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Sets the communication endpoint address the service instance must use to deliver information about its health state, execution state, failures and metrics."
        },
        {
          "info": {
            "name": "Retrieves a EventSubscription by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/hub/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Identifier of the EventSubscription"
              }
            ]
          },
          "docs": "This operation retrieves a EventSubscription entity."
        },
        {
          "info": {
            "name": "Unregister a listener",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{serverBase}/mefApi/interlude/serviceOrderingManagement/v1/hub/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id of the registered listener"
              }
            ]
          },
          "docs": "Resets the communication endpoint address the service instance must use to deliver information about its health state, execution state, failures and metrics."
        }
      ]
